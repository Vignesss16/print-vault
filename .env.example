# ==============================================================================
# PrintVault Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Copy this file to .env.local for local development.
# - In Vercel, add these variables in Project Settings > Environment Variables.
# - NEVER commit real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Main Application Configuration
# ------------------------------------------------------------------------------
# Public base URL of the Next.js application (used in customer upload links)
# Local: http://localhost:3000
# Vercel: https://print-vault-livid.vercel.app
NEXT_PUBLIC_APP_URL=https://print-vault-livid.vercel.app

# Internal base URL for server-to-server calls (e.g. creating upload sessions)
PRINTVAULT_API_BASE_URL=https://print-vault-livid.vercel.app

# Internal authorization secret used to protect server-to-server endpoints:
# - POST /api/sessions/upload (validated against X-Internal-Secret)
# - POST /api/whatsapp/send (validated against X-Internal-Secret or Bearer token)
PRINTVAULT_INTERNAL_SECRET=your_secure_internal_secret_here

# ------------------------------------------------------------------------------
# 2. Meta WhatsApp Business Cloud API (WhatsApp Component)
# ------------------------------------------------------------------------------
# System User / Permanent Access Token from Meta Developer Dashboard
# Used exclusively server-side to send outbound messages via Graph API
WHATSAPP_TOKEN=your_whatsapp_access_token_here

# WhatsApp Business Phone Number ID from Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Custom verification token you define in Meta Developer Dashboard > WhatsApp > Configuration
# Used ONLY to verify the webhook handshake (GET /api/whatsapp/webhook)
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Meta App Secret from Meta App Dashboard > App Settings > Basic
# Used to verify HMAC-SHA256 signatures (X-Hub-Signature-256) on incoming webhooks (POST /api/whatsapp/webhook)
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Meta Graph API Version (recommended: v22.0)
WHATSAPP_GRAPH_API_VERSION=v22.0

# Set to "true" to simulate WhatsApp messaging locally without contacting real Meta servers
WHATSAPP_MOCK_MODE=false

# ------------------------------------------------------------------------------
# 3. Supabase / Database Configuration (Main Application)
# ------------------------------------------------------------------------------
# Supabase project URL (optional for demo; app falls back to local memory cache if omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase public anonymous API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase secret service-role API key (server-side only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here