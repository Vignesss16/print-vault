# ==============================================================================
# WhatsApp Business Cloud API Configuration (Meta Developer Portal)
# ==============================================================================
# System User / Permanent Access Token with whatsapp_business_messaging permissions
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_access_token_here

# WhatsApp Phone Number ID (from Meta WhatsApp App Dashboard > API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Meta App Secret (from App Dashboard > App Settings > Basic) used to verify webhook signatures (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Custom verification token you define in Meta Developer Portal Webhooks configuration
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Meta Graph API Version (recommended: v22.0 or latest supported)
WHATSAPP_GRAPH_API_VERSION=v22.0

# Public URL where this application receives Meta webhooks (e.g. ngrok or production domain)
# Format: https://yourdomain.com/api/whatsapp/webhook
WHATSAPP_WEBHOOK_PUBLIC_URL=https://your-domain.com/api/whatsapp/webhook

# ==============================================================================
# Secure Print Shop Integration Configuration
# ==============================================================================
# Base URL for the Secure Upload portal hosted by the main application
SECURE_UPLOAD_BASE_URL=https://secure-printshop.example.com/upload

# Secret API key used to protect POST /api/whatsapp/send from unauthenticated external access
WHATSAPP_INTERNAL_API_KEY=your_internal_api_secret_key_for_service_calls

# Set to "true" to run in local mock mode without contacting real Meta servers
WHATSAPP_MOCK_MODE=false
